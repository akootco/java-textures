{
  "model": {
    "type": "select",
    "property": "custom_model_data",
    "fallback": {
      "type": "model",
      "model": "plushies:block/furniture/bench/bamboo/single"
    },
    "cases": [
      {"when": "left", "model": {"type": "model", "model": "plushies:block/furniture/bench/bamboo/left"}},
      {"when": "middle", "model": {"type": "model", "model": "plushies:block/furniture/bench/bamboo/middle"}},
      {"when": "right", "model": {"type": "model", "model": "plushies:block/furniture/bench/bamboo/right"}}
    ]
  }
}